# Hatsun RDMS Backend Environment Variables

PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_string_in_production_min_32_chars

# Database file location (use absolute path when mounting persistent disks, e.g., /var/data/database.sqlite)
DB_PATH=./database.sqlite

# Auto-seed database on start if empty (set to false to disable)
AUTO_SEED=true

# Allowed CORS origin(s) - e.g. https://your-frontend.vercel.app or * for all
CORS_ORIGIN=*
